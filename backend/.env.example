# Server
PORT=3000
NODE_ENV=development

# Postgres (matches docker-compose)
DATABASE_URL=postgresql://monii:monii@localhost:5432/monii?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — signs every token. In production the server refuses to start unless this
# is 32+ random characters (generate with: openssl rand -base64 48).
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_DEVICE_TTL=31536000

# Heartbeat / presence
HEARTBEAT_INTERVAL_SECONDS=75
HEARTBEAT_MISS_GRACE=2

# Command spine
COMMAND_TTL_SECONDS=300

# FCM (path to a service-account JSON, or leave blank to use the no-op stub in dev)
FCM_SERVICE_ACCOUNT_PATH=

# Rate limit on login / register / refresh / pairing claim / device re-auth,
# per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Set to the number of reverse-proxy hops (e.g. 1) when running behind a load
# balancer, so rate limits apply to the real client IP. Leave blank locally.
TRUST_PROXY=
